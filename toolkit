# IT Technician Toolkit - Short Link Launcher
# Short command: irm jlesc2026.github.io/toolkit | iex

$PayloadOwner  = 'JLESC2026'
$PayloadRepo   = 'IT-Tech-Support-Tool-Kit'
$PayloadBranch = 'main'

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ProgressPreference = 'SilentlyContinue'

$installerSelfUrl = "https://jlesc2026.github.io/toolkit"
$zipUrl           = "https://github.com/$PayloadOwner/$PayloadRepo/archive/refs/heads/$PayloadBranch.zip"

function Write-Step { param([string]$m) Write-Host "[ITTK] $m" -ForegroundColor Cyan }

if ($env:OS -ne 'Windows_NT') {
    Write-Host '[ITTK] This toolkit runs on Windows only.' -ForegroundColor Red
    return
}

# ---------- Elevate (Required for IT repair tools) ----------
$id = [Security.Principal.WindowsIdentity]::GetCurrent()
$isAdmin = (New-Object Security.Principal.WindowsPrincipal($id)).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin -and $env:ITTK_NOADMIN -ne '1') {
    Write-Step 'Requesting administrator elevation...'
    try {
        $cmd = "irm '$installerSelfUrl' | iex"
        Start-Process -FilePath (Join-Path $PSHOME 'powershell.exe') -Verb RunAs `
            -ArgumentList "-NoProfile -ExecutionPolicy Bypass -Command `"$cmd`""
        return
    } catch {
        Write-Host '[ITTK] Elevation cancelled.' -ForegroundColor Yellow
        return
    }
}

# Create a secure, isolated temporary workspace
$tmp = Join-Path $env:TEMP ("ittk_" + [guid]::NewGuid().ToString('N'))
try {
    New-Item -ItemType Directory -Path $tmp -Force | Out-Null
    $zip = Join-Path $tmp 'toolkit.zip'

    Write-Step "Downloading toolkit from $PayloadRepo..."
    Invoke-WebRequest -Uri $zipUrl -OutFile $zip -UseBasicParsing

    Write-Step 'Extracting to temporary memory/temp space...'
    $extract = Join-Path $tmp 'x'
    Expand-Archive -LiteralPath $zip -DestinationPath $extract -Force
    
    $src = Get-ChildItem -LiteralPath $extract -Directory | Select-Object -First 1
    $toolkitScript = Join-Path $src.FullName 'Launcher\Toolkit.ps1'

    if (-not (Test-Path $toolkitScript)) {
        throw 'Toolkit launcher not found in download package.'
    }

    Get-ChildItem -LiteralPath $src.FullName -Recurse -File -ErrorAction SilentlyContinue | Unblock-File -ErrorAction SilentlyContinue

    Write-Step 'Launching toolkit... (Window will stay open during support session)'
    $ps = Join-Path $PSHOME 'powershell.exe'
    
    # -Wait keeps the temp files alive while your IT techs work
    Start-Process -FilePath $ps -WorkingDirectory (Split-Path $toolkitScript) `
        -ArgumentList "-NoProfile -ExecutionPolicy Bypass -STA -File `"$toolkitScript`"" -Wait

    Write-Step 'Toolkit session ended. Purging local files...'

} catch {
    Write-Host "[ITTK] Error: $($_.Exception.Message)" -ForegroundColor Red
} finally {
    # AUTOMATIC PURGE: Deletes everything downloaded, leaving zero footprint.
    if (Test-Path $tmp) {
        Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
        Write-Step 'Cleanup complete. System is clean.'
    }
}